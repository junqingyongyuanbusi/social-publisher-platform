NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://publisher.example.com
API_INTERNAL_URL=http://api:3001
# DATABASE_URL and REDIS_URL are assembled at container startup from Compose secrets.
OIDC_ISSUER=https://identity.example.com/realms/social-publisher
OIDC_AUDIENCE=social-publisher-api
OIDC_JWKS_URI=https://identity.example.com/realms/social-publisher/protocol/openid-connect/certs
OIDC_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
BROWSER_OIDC_ISSUER=https://identity.example.com/realms/social-publisher
BROWSER_OIDC_CLIENT_ID=social-publisher-web
BROWSER_OIDC_REDIRECT_URI=https://publisher.example.com/api/auth/callback
BROWSER_OIDC_SCOPE=openid profile email offline_access
BROWSER_SESSION_KEYS_JSON={"activeKeyId":"production-v1","keys":{"production-v1":"replace-with-a-random-32-byte-base64-key"}}
KC_HOSTNAME=https://identity.example.com
KC_HOSTNAME_STRICT=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
CREDENTIAL_KEK_PROVIDER=aws-kms
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/replace
MEDIA_STORAGE_PROVIDER=s3
MEDIA_S3_BUCKET=social-publisher-production
MEDIA_S3_REGION=us-east-1
PLATFORM_OAUTH_CALLBACK_URL=https://publisher.example.com/api/platform-oauth/callback
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
