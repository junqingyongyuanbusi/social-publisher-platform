{
  "realm": "social-publisher",
  "displayName": "Social Publisher",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read workspaces and diagnostics" },
      { "name": "operator", "description": "Create and operate publications" },
      { "name": "admin", "description": "Manage accounts and platform credentials" },
      { "name": "owner", "description": "Full workspace administration" }
    ]
  },
  "clients": [
    {
      "clientId": "social-publisher-api",
      "name": "Social Publisher API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "social-publisher-web",
      "name": "Social Publisher Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "https://publisher.example.com/api/auth/callback"
      ],
      "webOrigins": ["http://localhost:3000", "https://publisher.example.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://publisher.example.com/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "social-publisher-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "social-publisher-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
