{
  "name": "@social/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1009.0",
    "@aws-sdk/s3-request-presigner": "3.1009.0",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@social/credential-vault": "workspace:*",
    "@social/credential-vault-aws": "workspace:*",
    "@social/database": "workspace:*",
    "@social/domain": "workspace:*",
    "@social/platform-facebook": "workspace:*",
    "@social/platform-instagram": "workspace:*",
    "@social/platform-x": "workspace:*",
    "bullmq": "5.79.0",
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
