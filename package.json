{
  "name": "social-publisher-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual social publishing platform for Instagram, Facebook Pages, and X",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @social/api --filter @social/web --filter @social/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --filter './packages/*' --if-present build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter './packages/*' --if-present build && pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @social/database prisma:generate",
    "db:migrate": "pnpm --filter @social/database prisma:migrate",
    "db:studio": "pnpm --filter @social/database prisma:studio"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prettier": "3.8.5",
    "typescript": "5.9.3"
  }
}
