NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://social:social@localhost:5432/social_publisher
REDIS_URL=redis://localhost:6379
CREDENTIAL_KEK_PROVIDER=local
CREDENTIAL_LOCAL_KEK_BASE64=generate-a-random-32-byte-base64-key-for-development-only
CREDENTIAL_LOCAL_KEK_VERSION=local-dev-v1
# Production example: set provider to aws-kms and configure workload identity, never static AWS keys.
AWS_KMS_KEY_ID=
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
DEFAULT_LOCALE=zh-CN

# Do not commit real credentials. Platform credentials are encrypted in the application.
X_CLIENT_ID=
META_APP_ID=
