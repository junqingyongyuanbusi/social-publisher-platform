NODE_ENV=development
API_PORT=3001
# Readiness dependency probes fail fast and never expose connection details.
API_READINESS_TIMEOUT_MS=1000
WEB_PORT=3000
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://social:replace-with-the-same-local-password@localhost:5432/social_publisher
REDIS_URL=redis://localhost:6379
PLATFORM_OAUTH_CALLBACK_URL=http://localhost:3000/api/platform-oauth/callback
PLATFORM_OAUTH_TRANSACTION_TTL_SECONDS=600
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=/tmp/social-publisher-media
# Production: use s3 and configure MEDIA_S3_BUCKET, MEDIA_S3_REGION and optional MEDIA_S3_ENDPOINT.
CREDENTIAL_KEK_PROVIDER=local
CREDENTIAL_LOCAL_KEK_BASE64=generate-a-random-32-byte-base64-key-for-development-only
CREDENTIAL_LOCAL_KEK_VERSION=local-dev-v1
# Production example: set provider to aws-kms and configure workload identity, never static AWS keys.
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001
DEFAULT_LOCALE=zh-CN
WEB_ORIGIN=http://localhost:3000

# API access-token validation. Use the provider's exact issuer, API audience, and HTTPS JWKS URI.
OIDC_ISSUER=http://localhost:8080/realms/social-publisher
OIDC_AUDIENCE=social-publisher-api
OIDC_JWKS_URI=http://localhost:8080/realms/social-publisher/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256,ES256
OIDC_MAX_TOKEN_AGE_SECONDS=3600
OIDC_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
ENABLE_SWAGGER=true

# Browser OIDC BFF. CLIENT_SECRET may be empty for a public PKCE client.
BROWSER_OIDC_ISSUER=http://localhost:8080/realms/social-publisher
BROWSER_OIDC_CLIENT_ID=social-publisher-web
BROWSER_OIDC_CLIENT_SECRET=
BROWSER_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
BROWSER_OIDC_SCOPE=openid profile email offline_access
BROWSER_AUTH_TRANSACTION_TTL_SECONDS=600
BROWSER_SESSION_TTL_SECONDS=28800
BROWSER_TOKEN_REFRESH_SKEW_SECONDS=60
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROWSER_SESSION_KEYS_JSON={"activeKeyId":"local-v1","keys":{"local-v1":"replace-with-a-random-32-byte-base64-key"}}

# Local Keycloak bootstrap. Replace all values before starting Compose.
KEYCLOAK_DB_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_OWNER_PASSWORD=replace-with-a-random-local-password

# Do not commit real credentials. Platform credentials are encrypted in the application.
X_CLIENT_ID=
META_APP_ID=
